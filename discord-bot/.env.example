DISCORD_TOKEN=your_discord_bot_token
DATABASE_PATH=data/bot.sqlite3
KEY_PREFIX=FREE_
KEY_HEX_LENGTH=32

# Authorized Provider Configuration (Optional)
PROVIDER_ENABLED=false
PROVIDER_BASE_URL=
PROVIDER_API_KEY=
PROVIDER_ALLOWED_HOST=

# Backend API Sync Credentials (Preferred)
BACKEND_API_URL=https://your-backend-render-app.onrender.com
BOT_API_KEY=your_bot_api_key

# Supabase Credentials for Kaitun Stock Sync (Direct Fallback)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
STOCK_ENCRYPTION_SECRET=your_stock_encryption_secret
