# Supabase PostgreSQL Connection
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase API Configuration
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application Security & Encryption
PORT=4000
JWT_SECRET="your-jwt-secret"
STOCK_ENCRYPTION_SECRET="your-aes-256-gcm-encryption-secret"
FRONTEND_URL="https://kizort-shop.vercel.app"
FRONTEND_HEALTH_URL="https://kizort-shop.vercel.app"
BOT_API_KEY="your-internal-bot-api-key"

# Thresholds & Alerts
LOW_STOCK_THRESHOLD=2
LARGE_TOPUP_AMOUNT=2000
TICKET_STALE_HOURS=6

# Discord Bot Notifications (Store / Notify Bot)
DISCORD_NOTIFY_BOT_TOKEN="your-discord-notify-bot-token"

# Discord Ops Bot (System Health, Monitoring & Admin Slash Commands)
DISCORD_OPS_BOT_TOKEN="your-discord-ops-bot-token"
DISCORD_OPS_PUBLIC_KEY="your-discord-ops-public-key-for-ed25519-verification"
DISCORD_OPS_APP_ID="your-discord-ops-application-id"

# Discord Server / Guild & Permissions
DISCORD_GUILD_ID="your-discord-guild-id"
DISCORD_ADMIN_ROLE_ID="your-discord-admin-role-id"
