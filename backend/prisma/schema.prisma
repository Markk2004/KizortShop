datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MEMBER
}

enum OrderStatus {
  COMPLETED
  PENDING
  FAILED
  REFUNDED
}

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
  CLAIMED_DEFECTIVE
}

enum StockMode {
  POOL
  UNIQUE_1TO1
}

enum CredentialFormat {
  USER_PASS
  USER_PASS_2FA
  COOKIE_TOKEN
  REDEEM_KEY
}

enum TopupStatus {
  PENDING_VERIFY
  SUCCESS
  REJECTED
}

enum BannerSlot {
  HERO_MAIN
  PROMO_SIDE
  ANNOUNCEMENT_BAR
}

model User {
  id           String             @id @default(uuid())
  username     String             @unique
  email        String             @unique
  passwordHash String
  role         Role               @default(MEMBER)
  isActive     Boolean            @default(true)
  banReason    String?
  lastLoginAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  wallet       Wallet?
  orders       Order[]
  topups       TopupTransaction[]
  reviews      Review[]
  tickets      Ticket[]
  auditLogs    AuditLog[]

  @@index([role, isActive])
  @@index([createdAt])
}

model Wallet {
  id         String   @id @default(uuid())
  userId     String   @unique
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  totalTopup Decimal  @default(0) @db.Decimal(12, 2)
  totalSpent Decimal  @default(0) @db.Decimal(12, 2)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String
  badge       String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, sortOrder])
}

model Banner {
  id        String     @id @default(uuid())
  title     String
  subtitle  String?
  tag       String?
  image     String
  linkUrl   String?
  slot      BannerSlot @default(HERO_MAIN)
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([slot, isActive, sortOrder])
}

model Product {
  id               String           @id @default(uuid())
  code             String           @unique // รหัส SKU มาตรฐาน เช่น BF-V4-MAX-01 หรือ UNQ-KITSUNE-89
  title            String
  description      String?
  price            Decimal          @db.Decimal(10, 2)
  originalPrice    Decimal?         @db.Decimal(10, 2)
  badge            String?
  image            String
  stockMode        StockMode        @default(POOL) // POOL (หลายไอดีต่อ 1 SKU) หรือ UNIQUE_1TO1 (1 SKU = 1 ไอดีคัดเฉพาะ)
  credentialFormat CredentialFormat @default(USER_PASS) // บังคับโครงสร้างข้อมูลตอนแอดมิน Bulk Import
  isFeatured       Boolean          @default(false)
  isActive         Boolean          @default(true)
  sortOrder        Int              @default(0)
  categoryId       String
  category         Category         @relation(fields: [categoryId], references: [id])
  stocks           AccountStock[]
  orders           Order[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([categoryId, isActive, sortOrder])
  @@index([isFeatured, isActive])
}

model AccountStock {
  id               String           @id @default(uuid())
  serialCode       String           @unique // รหัสอ้างอิงรายชิ้น เช่น STK-BFV4-261018-0001
  productId        String
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  credentialFormat CredentialFormat @default(USER_PASS)
  credentialHash   String           @unique // HMAC-SHA256 ของ normalized username/key เพื่อบล็อกการลงไอดีซ้ำทั้งระบบ
  maskedIdentity   String // เช่น usr_k4*** (ใช้แสดงในตาราง Admin โดยไม่ต้องถอดรหัส AES-256 ทั้งตาราง)
  credentials      String // ข้อมูลลับเข้ารหัส AES-256-GCM (JSON/Delimited ตาม credentialFormat)
  username         String? // ชื่อผู้ใช้ Roblox (เก็บชัดเจนเพื่อค้นหาได้ทั้งจาก Discord และ Web)
  cookie           String? // Cookie สำหรับเข้าสู่ระบบ (ถ้ามี)
  sellingPriceText String? // ราคาขายที่ระบุจาก Discord (เช่น 150 บาท)
  addedSource      String           @default("WEB") // WEB หรือ DISCORD
  addedByDiscordId String? // Discord User ID ของผู้เพิ่ม
  farmedMaps       String? // แมพที่ฟาร์ม (รองรับเชื่อมต่อข้อมูลจากระบบ Kaitun Bot)
  details          String? // รายละเอียดของในไอดี
  batchCode        String? // รหัสล็อตนำเข้า เช่น LOT-20261018-A
  supplierName     String? // ชื่อซัพพลายเออร์/แม่ค้าส่ง เพื่อเช็กย้อนหลังเวลาไอดีมีปัญหา
  costPrice        Decimal?         @db.Decimal(10, 2) // ต้นทุนรับเข้าต่อชิ้นสำหรับคำนวณกำไรสุทธิ
  defectReason     String? // บันทึกสาเหตุกรณีสถานะถูกเปลี่ยนเป็น CLAIMED_DEFECTIVE
  status           StockStatus      @default(AVAILABLE)
  orderId          String?          @unique
  order            Order?           @relation(fields: [orderId], references: [id])
  soldAt           DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([productId, status, createdAt])
  @@index([username])
  @@index([batchCode])
  @@index([status])
}

model Order {
  id           String        @id @default(uuid())
  orderNumber  String        @unique
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  productId    String
  product      Product       @relation(fields: [productId], references: [id])
  amount       Decimal       @db.Decimal(10, 2)
  costAmount   Decimal?      @db.Decimal(10, 2)
  status       OrderStatus   @default(COMPLETED)
  note         String?
  deliveredKey AccountStock?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model TopupTransaction {
  id              String      @id @default(uuid())
  transactionCode String?     @unique
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  amount          Decimal     @db.Decimal(10, 2)
  bonusAmount     Decimal     @default(0) @db.Decimal(10, 2)
  paymentMethod   String // PROMPTPAY_QR, TRUEMONEY
  slipUrl         String?
  slipRef         String?     @unique
  rejectReason    String?
  verifiedBy      String?
  verifiedAt      DateTime?
  status          TopupStatus @default(PENDING_VERIFY)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Ticket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?
  subject   String
  detail    String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String // เช่น REVEAL_STOCK_CREDENTIAL, UPDATE_ORDER_STATUS, APPROVE_TOPUP
  targetType String // เช่น STOCK, ORDER, TOPUP, USER, PRODUCT
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorId, createdAt])
}

model WebhookChannelConfig {
  id          String   @id @default(uuid())
  channelKey  String   @unique // kaitun_sync, orders, topups, stocks, catalog, members, tickets_audit
  channelName String // เช่น #kaitun-id, #web-orders
  channelId   String? // Discord Channel ID
  webhookUrl  String // Discord Webhook URL
  isActive    Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([channelKey, isActive])
}

model Expense {
  id        String   @id @default(uuid())
  title     String // เช่น ค่าไฟฟาร์ม, ค่า VPS, ค่าสคริปต์รายเดือน
  category  String   @default("OTHER") // SCRIPT, VPS, ELECTRICITY, BOT_HOST, OTHER
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, paidAt])
}

